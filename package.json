{
  "name": "gastos-compartidos",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Reparte los gastos de un viaje, una cena o un piso compartido y calcula el mínimo de pagos para quedar en paz.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "preview": "astro preview --port 4322",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "test": "node --test \"tests/*.test.ts\"",
    "db:seed": "node scripts/seed.ts",
    "fix:compiler": "node scripts/fix-compiler.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
