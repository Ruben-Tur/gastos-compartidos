# Copia este archivo como .env y ajusta los valores. Ninguno es obligatorio en local.

# Base de datos. En local es un archivo SQLite; en producción puede ser una URL libsql:// de Turso.
DATABASE_URL=file:./data/gastos.db
# Solo necesario con Turso u otro servidor libSQL remoto.
DATABASE_AUTH_TOKEN=

# URL pública de la web, con https en producción. Se lee al compilar: enlace canónico, Open Graph,
# sitemap y el dominio en el que se confía cuando la web va detrás de un proxy HTTPS.
SITE_URL=http://localhost:4322

# Solo detrás de un proxy: cabecera con la IP real del visitante que la plataforma SIEMPRE sobrescribe
# (fly-client-ip en Fly.io, cf-connecting-ip con Cloudflare, x-real-ip con nginx configurado así).
# Se usa para el límite de peticiones. Déjala vacía si no estás seguro.
TRUSTED_IP_HEADER=
