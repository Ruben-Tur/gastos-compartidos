---
import Base from '../layouts/Base.astro';

Astro.response.status = 404;
---

<Base title="Página no encontrada" private>
  <div class="container page not-found">
    <p class="mono muted">404</p>
    <h1>No encontramos esta página</h1>
    <p>
      Si buscabas un grupo, revisa que el enlace esté completo: los enlaces de grupo son largos a propósito y con una
      letra de menos ya no funcionan.
    </p>
    <p><a class="button" href="/">Ir al inicio</a></p>
  </div>
</Base>

<style>
  .not-found {
    display: grid;
    gap: var(--s4);
    max-width: calc(36rem + 2 * var(--gutter));
  }

  .not-found h1 {
    font-size: var(--text-xl);
  }
</style>
