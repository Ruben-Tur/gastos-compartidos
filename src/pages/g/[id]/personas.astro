---
import Base from '../../../layouts/Base.astro';
import '../../../styles/people.css';
import { FLASH } from '../../../lib/format.ts';
import { addMember, deleteMember, getGroup, getMembers, renameGroup, renameMember, UserError } from '../../../lib/groups.ts';
import { isGroupId } from '../../../lib/ids.ts';
import { field, LIMITS, parseId, requiredText } from '../../../lib/validate.ts';

const { id } = Astro.params;
if (!isGroupId(id)) return Astro.rewrite('/404');
const group = await getGroup(id);
if (!group) return Astro.rewrite('/404');

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = field(form, 'action');
  const name = (label: string, max: number) => {
    const checked = requiredText(field(form, 'name').slice(0, 500), max, label);
    if (!checked.ok) throw new UserError(checked.error);
    return checked.value;
  };
  const member = () => {
    const memberId = parseId(field(form, 'member'));
    if (memberId === null) throw new UserError('Persona no válida.');
    return memberId;
  };
  try {
    let ok: string;
    if (action === 'rename-group') {
      await renameGroup(id, name('un nombre para el grupo', LIMITS.groupName));
      ok = 'grupo-editado';
    } else if (action === 'add') {
      await addMember(id, name('un nombre', LIMITS.memberName));
      ok = 'persona';
    } else if (action === 'rename') {
      await renameMember(id, member(), name('un nombre', LIMITS.memberName));
      ok = 'persona-editada';
    } else if (action === 'delete') {
      await deleteMember(id, member());
      ok = 'persona-borrada';
    } else {
      throw new UserError('Acción no válida.');
    }
    return Astro.redirect(`/g/${id}/personas?ok=${ok}`, 303);
  } catch (e) {
    if (!(e instanceof UserError)) throw e;
    error = e.message;
    Astro.response.status = 422;
  }
}

const members = await getMembers(id);
const flash = FLASH[Astro.url.searchParams.get('ok') ?? ''];
---

<Base title={`Personas · ${group.name}`} private>
  <div class="container page narrow">
    <div class="page-head">
      <p class="breadcrumb"><a href={`/g/${id}`}>← {group.name}</a></p>
      <h1>Personas y grupo</h1>
    </div>

    {flash && <p class="notice flash" role="status">{flash}</p>}
    {
      error && (
        <p class="notice notice--error flash" role="alert">
          <strong>No se ha podido hacer:</strong> {error}
        </p>
      )
    }

    <section class="card block" aria-labelledby="personas">
      <h2 id="personas" class="card__title">Personas</h2>
      <ul role="list" class="people">
        {
          members.map((m) => (
            <li class="person">
              <form method="post" class="person__rename">
                <input type="hidden" name="action" value="rename" />
                <input type="hidden" name="member" value={m.id} />
                <label class="sr-only" for={`name-${m.id}`}>
                  Nombre de {m.name}
                </label>
                <input id={`name-${m.id}`} name="name" type="text" required maxlength={LIMITS.memberName} value={m.name} />
                <button class="button button--small button--secondary" type="submit">
                  Guardar<span class="sr-only"> el nombre de {m.name}</span>
                </button>
              </form>
              <form method="post">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="member" value={m.id} />
                <button class="link-button" type="submit">
                  Quitar<span class="sr-only"> a {m.name}</span>
                </button>
              </form>
            </li>
          ))
        }
      </ul>
      <p class="hint">Solo se puede quitar a quien todavía no aparece en ningún gasto ni pago.</p>

      {
        members.length < LIMITS.membersPerGroup ? (
          <form method="post" class="add">
            <input type="hidden" name="action" value="add" />
            <div class="field">
              <label for="new-member">Añadir persona</label>
              <div class="inline">
                <input
                  id="new-member"
                  name="name"
                  type="text"
                  required
                  maxlength={LIMITS.memberName}
                  placeholder="Nombre"
                  autocomplete="off"
                />
                <button class="button" type="submit">
                  Añadir
                </button>
              </div>
            </div>
          </form>
        ) : (
          <p class="hint">El grupo ya tiene el máximo de {LIMITS.membersPerGroup} personas.</p>
        )
      }
    </section>

    <section class="card block" aria-labelledby="grupo">
      <h2 id="grupo" class="card__title">Nombre del grupo</h2>
      <form method="post">
        <input type="hidden" name="action" value="rename-group" />
        <label for="group-name" class="sr-only">Nombre del grupo</label>
        <div class="inline">
          <input id="group-name" name="name" type="text" required maxlength={LIMITS.groupName} value={group.name} />
          <button class="button button--secondary" type="submit">Guardar</button>
        </div>
      </form>
    </section>
  </div>
</Base>
